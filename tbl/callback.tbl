if (!update.callback_query) return;

const cb = update.callback_query;
const cbData = cb.data;
const cbChatId = cb.message.chat.id;
const cbMsgId = cb.message.message_id;
const cbQueryId = cb.id;

const RAW_BASE = "https://raw.githubusercontent.com/FLOKI000/aibot/main/content";

function getRandom(arr) {
  return arr[Math.floor(Math.random() * arr.length)];
}

async function fetchContent(filename) {
  const resp = await HTTP.get({ url: RAW_BASE + "/" + filename });
  if (!resp.ok || !resp.data) return null;
  return resp.data;
}

function addScore(points) {
  const current = User.get("score") || 0;
  User.set("score", current + points, "number");
}

// MAIN MENU
if (cbData === "main_menu") {
  Api.answerCallbackQuery({ callback_query_id: cbQueryId });
  Api.editMessageText({
    chat_id: cbChatId,
    message_id: cbMsgId,
    text: "🏠 منوی اصلی\n\nیه گزینه انتخاب کن 👇",
    reply_markup: {
      inline_keyboard: [
        [
          { text: "🤣 جوک امروز", callback_data: "get_joke" },
          { text: "🖼️ میم جدید", callback_data: "get_meme" }
        ],
        [
          { text: "🕵️ حدس شخصیت", callback_data: "start_character" },
          { text: "🎬 دیالوگ تصادفی", callback_data: "get_dialogue" }
        ],
        [{ text: "⭐ امتیاز من", callback_data: "my_score" }]
      ]
    }
  });
  return;
}

// JOKE
if (cbData === "get_joke") {
  Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "🤣 جوک میاد..." });
  const jokes = await fetchContent("jokes.json");
  if (!jokes) {
    Api.editMessageText({ chat_id: cbChatId, message_id: cbMsgId, text: "❌ خطا در دریافت جوک" });
    return;
  }
  const joke = getRandom(jokes);
  addScore(1);
  Api.editMessageText({
    chat_id: cbChatId,
    message_id: cbMsgId,
    text: joke.text,
    reply_markup: {
      inline_keyboard: [
        [
          { text: "😂 جوک بعدی", callback_data: "get_joke" },
          { text: "👍 خندیدم!", callback_data: "react_funny" }
        ],
        [{ text: "🏠 منو", callback_data: "main_menu" }]
      ]
    }
  });
  return;
}

// MEME
if (cbData === "get_meme") {
  Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "🖼️ میم میاد..." });
  const memes = await fetchContent("memes.json");
  if (!memes) {
    Api.editMessageText({ chat_id: cbChatId, message_id: cbMsgId, text: "❌ خطا در دریافت میم" });
    return;
  }
  const meme = getRandom(memes);
  addScore(1);
  Api.editMessageText({
    chat_id: cbChatId,
    message_id: cbMsgId,
    text: meme.text,
    reply_markup: {
      inline_keyboard: [
        [
          { text: "😂 میم بعدی", callback_data: "get_meme" },
          { text: "🔥 خفنه!", callback_data: "react_meme" }
        ],
        [{ text: "🏠 منو", callback_data: "main_menu" }]
      ]
    }
  });
  return;
}

// DIALOGUE
if (cbData === "get_dialogue") {
  Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "🎬 دیالوگ میاد..." });
  const dialogues = await fetchContent("dialogues.json");
  if (!dialogues) {
    Api.editMessageText({ chat_id: cbChatId, message_id: cbMsgId, text: "❌ خطا در دریافت دیالوگ" });
    return;
  }
  const dialogue = getRandom(dialogues);
  addScore(1);
  Api.editMessageText({
    chat_id: cbChatId,
    message_id: cbMsgId,
    text: dialogue.text,
    reply_markup: {
      inline_keyboard: [
        [
          { text: "🎬 دیالوگ بعدی", callback_data: "get_dialogue" },
          { text: "❤️ عالیه!", callback_data: "react_dialogue" }
        ],
        [{ text: "🏠 منو", callback_data: "main_menu" }]
      ]
    }
  });
  return;
}

// MY SCORE
if (cbData === "my_score") {
  Api.answerCallbackQuery({ callback_query_id: cbQueryId });
  const score = User.get("score") || 0;
  let rank = "🥉 تازه‌کار";
  if (score >= 50) rank = "🥇 افسانه";
  else if (score >= 20) rank = "🥈 حرفه‌ای";
  else if (score >= 10) rank = "⭐ کاربر فعال";
  Api.editMessageText({
    chat_id: cbChatId,
    message_id: cbMsgId,
    text: "⭐ امتیاز تو: " + score + " نقطه\n🏅 رتبه: " + rank,
    reply_markup: {
      inline_keyboard: [[{ text: "🏠 منو", callback_data: "main_menu" }]]
    }
  });
  return;
}

// CHARACTER GAME
if (cbData === "start_character") {
  Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "🕵️ بازی شروع شد!" });
  const chars = await fetchContent("characters.json");
  if (!chars) {
    Api.editMessageText({ chat_id: cbChatId, message_id: cbMsgId, text: "❌ خطا در بارگذاری بازی" });
    return;
  }
  const char = getRandom(chars);
  User.set("char_id", char.id, "number");
  User.set("char_clue", 0, "number");
  Api.editMessageText({
    chat_id: cbChatId,
    message_id: cbMsgId,
    text: "🕵️ بازی حدس شخصیت!\n\n🔑 سرنخ ۱ از " + char.clues.length + ":\n" + char.clues[0],
    reply_markup: {
      inline_keyboard: [
        [{ text: "🔍 سرنخ بعدی (-1 امتیاز)", callback_data: "next_clue" }],
        [{ text: "✅ جواب می‌دونم!", callback_data: "show_answer" }],
        [{ text: "🏠 منو", callback_data: "main_menu" }]
      ]
    }
  });
  return;
}

if (cbData === "next_clue") {
  const chars = await fetchContent("characters.json");
  const charId = User.get("char_id");
  let clueIdx = (User.get("char_clue") || 0) + 1;
  const char = chars ? chars.find(c => c.id === charId) : null;
  if (!char) {
    Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "❌ دوباره شروع کن" });
    return;
  }
  if (clueIdx >= char.clues.length) {
    Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "همه سرنخ‌ها تموم شد!" });
    Api.editMessageText({
      chat_id: cbChatId,
      message_id: cbMsgId,
      text: char.emoji + " جواب: " + char.answer + "\n\nهمه سرنخ‌ها رو دیدی! 🎭",
      reply_markup: {
        inline_keyboard: [
          [{ text: "🔄 شخصیت جدید", callback_data: "start_character" }],
          [{ text: "🏠 منو", callback_data: "main_menu" }]
        ]
      }
    });
    return;
  }
  User.set("char_clue", clueIdx, "number");
  addScore(-1);
  Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "-1 امتیاز" });
  Api.editMessageText({
    chat_id: cbChatId,
    message_id: cbMsgId,
    text: "🔑 سرنخ " + (clueIdx + 1) + " از " + char.clues.length + ":\n" + char.clues[clueIdx],
    reply_markup: {
      inline_keyboard: [
        clueIdx < char.clues.length - 1 ? [{ text: "🔍 سرنخ بعدی (-1 امتیاز)", callback_data: "next_clue" }] : [],
        [{ text: "✅ جواب می‌دونم!", callback_data: "show_answer" }],
        [{ text: "🏠 منو", callback_data: "main_menu" }]
      ].filter(r => r.length > 0)
    }
  });
  return;
}

if (cbData === "show_answer") {
  const chars = await fetchContent("characters.json");
  const charId = User.get("char_id");
  const clueIdx = User.get("char_clue") || 0;
  const char = chars ? chars.find(c => c.id === charId) : null;
  if (!char) {
    Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "❌ خطا!" });
    return;
  }
  const scoreEarned = Math.max(5 - clueIdx, 1);
  addScore(scoreEarned);
  Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "+" + scoreEarned + " امتیاز!" });
  Api.editMessageText({
    chat_id: cbChatId,
    message_id: cbMsgId,
    text: char.emoji + " جواب: " + char.answer + "\n\n🎉 تو " + (clueIdx + 1) + " سرنخ حدس زدی!\n⭐ +" + scoreEarned + " امتیاز گرفتی!",
    reply_markup: {
      inline_keyboard: [
        [{ text: "🔄 شخصیت جدید", callback_data: "start_character" }],
        [{ text: "🏠 منو", callback_data: "main_menu" }]
      ]
    }
  });
  return;
}

// REACTIONS
if (cbData === "react_funny" || cbData === "react_meme" || cbData === "react_dialogue") {
  addScore(2);
  Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "❤️ +2 امتیاز!" });
  return;
}