if (!update.callback_query) return;

const cb = update.callback_query;
const cbData = cb.data;
const cbChatId = cb.message.chat.id;
const cbMsgId = cb.message.message_id;
const cbQueryId = cb.id;
const RAW_BASE = "https://raw.githubusercontent.com/FLOKI000/aibot/main/content";

async function askAI(systemPrompt, userMsg) {
  const resp = await HTTP.post({
    url: "https://api.deepseek.com/chat/completions",
    headers: {
      "Authorization": "Bearer " + Bot.get("claude_key"),
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      model: "deepseek-chat",
      max_tokens: 300,
      messages: [
        { role: "system", content: systemPrompt },
        { role: "user", content: userMsg }
      ]
    })
  });
  if (!resp.ok || !resp.data) return null;
  return resp.data.choices[0].message.content;
}

function getRandom(arr) {
  return arr[Math.floor(Math.random() * arr.length)];
}

async function fetchContent(filename) {
  const resp = await HTTP.get({ url: RAW_BASE + "/" + filename });
  if (!resp.ok || !resp.data) return null;
  return resp.data;
}

function addScore(points) {
  const s = User.get("score") || 0;
  User.set("score", s + points, "number");
}

// MAIN MENU
if (cbData === "main_menu") {
  Api.answerCallbackQuery({ callback_query_id: cbQueryId });
  Api.editMessageText({
    chat_id: cbChatId, message_id: cbMsgId,
    text: "🏠 منوی اصلی\n\nیه گزینه انتخاب کن " + user.first_name + " 👇",
    reply_markup: { inline_keyboard: [
      [{ text: "🤣 جوک امروز", callback_data: "get_joke" }, { text: "🖼️ میم جدید", callback_data: "get_meme" }],
      [{ text: "🕵️ حدس شخصیت", callback_data: "start_character" }, { text: "🎬 دیالوگ تصادفی", callback_data: "get_dialogue" }],
      [{ text: "⭐ امتیاز من", callback_data: "my_score" }, { text: "🤖 چت با AI", callback_data: "start_chat" }]
    ]}
  });
  return;
}

// JOKE
if (cbData === "get_joke") {
  Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "🤣 داره میاد..." });
  Api.editMessageText({ chat_id: cbChatId, message_id: cbMsgId, text: "⏳ AI داره جوک می‌سازه..." });
  const joke = await askAI(
    "یه دستیار سرگرمی فارسی هستی. فقط یه جوک خنده‌دار و کوتاه فارسی بنویس. بدون توضیح اضافه. فقط جوک. از ایموجی استفاده کن.",
    "یه جوک تازه بده که کسی نشنیده باشه"
  );
  addScore(1);
  Api.editMessageText({
    chat_id: cbChatId, message_id: cbMsgId,
    text: joke || "❌ خطا در تولید جوک. دوباره امتحان کن.",
    reply_markup: { inline_keyboard: [
      [{ text: "😂 جوک بعدی", callback_data: "get_joke" }, { text: "👍 خندیدم! +2", callback_data: "react_funny" }],
      [{ text: "🏠 منو", callback_data: "main_menu" }]
    ]}
  });
  return;
}

// MEME
if (cbData === "get_meme") {
  Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "🖼️ داره میاد..." });
  Api.editMessageText({ chat_id: cbChatId, message_id: cbMsgId, text: "⏳ AI داره میم می‌سازه..." });
  const meme = await askAI(
    "یه دستیار سرگرمی فارسی هستی. میم متنی فارسی بساز. فرمت: یه موقعیت خنده‌دار روزمره به سبک 'وقتی که...' با ایموجی. فقط متن میم، بدون توضیح.",
    "یه میم خنده‌دار فارسی بساز"
  );
  addScore(1);
  Api.editMessageText({
    chat_id: cbChatId, message_id: cbMsgId,
    text: meme || "❌ خطا. دوباره امتحان کن.",
    reply_markup: { inline_keyboard: [
      [{ text: "😂 میم بعدی", callback_data: "get_meme" }, { text: "🔥 خفنه! +2", callback_data: "react_meme" }],
      [{ text: "🏠 منو", callback_data: "main_menu" }]
    ]}
  });
  return;
}

// DIALOGUE
if (cbData === "get_dialogue") {
  Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "🎬 داره میاد..." });
  Api.editMessageText({ chat_id: cbChatId, message_id: cbMsgId, text: "⏳ AI داره دیالوگ می‌سازه..." });
  const dialogue = await askAI(
    "دیالوگ‌های ماندگار سینمای ایران و دنیا رو بلدی. یه دیالوگ احساسی یا فلسفی کوتاه بنویس. اسم فیلم یا سریال رو هم بنویس. از ایموجی استفاده کن.",
    "یه دیالوگ ماندگار بده"
  );
  addScore(1);
  Api.editMessageText({
    chat_id: cbChatId, message_id: cbMsgId,
    text: dialogue || "❌ خطا. دوباره امتحان کن.",
    reply_markup: { inline_keyboard: [
      [{ text: "🎬 دیالوگ بعدی", callback_data: "get_dialogue" }, { text: "❤️ عالیه! +2", callback_data: "react_dialogue" }],
      [{ text: "🏠 منو", callback_data: "main_menu" }]
    ]}
  });
  return;
}

// CHARACTER GAME - START
if (cbData === "start_character") {
  Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "🕵️ بازی شروع شد!" });
  Api.editMessageText({ chat_id: cbChatId, message_id: cbMsgId, text: "⏳ AI داره شخصیت انتخاب می‌کنه..." });
  const charData = await askAI(
    `یه بازی حدس شخصیت طراحی کن. یه شخصیت مشهور از فیلم، سریال، انیمیشن یا تاریخ انتخاب کن.
خروجی فقط JSON باشه بدون هیچ متن دیگه‌ای، بدون backtick:
{"name":"اسم شخصیت","clues":["سرنخ اول خیلی کلی","سرنخ دوم","سرنخ سوم","سرنخ چهارم نزدیک به جواب"]}
سرنخ‌ها فارسی باشن و از آسون به سخت.`,
    "یه شخصیت تازه و جالب انتخاب کن"
  );
  let char;
  try {
    const clean = (charData || "").replace(/```json|```/g, "").trim();
    char = JSON.parse(clean);
  } catch(e) {
    Api.editMessageText({ chat_id: cbChatId, message_id: cbMsgId, text: "❌ خطا در ساخت بازی. دوباره امتحان کن.",
      reply_markup: { inline_keyboard: [[{ text: "🔄 دوباره", callback_data: "start_character" }]] }
    });
    return;
  }
  User.set("char_name", char.name);
  User.set("char_clues", JSON.stringify(char.clues));
  User.set("char_clue_idx", 0, "number");
  User.set("char_state", "playing");
  Api.editMessageText({
    chat_id: cbChatId, message_id: cbMsgId,
    text: "🕵️ بازی حدس شخصیت!\n\n🔑 سرنخ ۱ از ۴:\n" + char.clues[0] + "\n\n✍️ اسم شخصیت رو تایپ کن:",
    reply_markup: { inline_keyboard: [
      [{ text: "🔍 سرنخ بعدی (-1 امتیاز)", callback_data: "next_clue" }],
      [{ text: "🏳️ تسلیم شدم", callback_data: "give_up" }],
      [{ text: "🏠 منو", callback_data: "main_menu" }]
    ]}
  });
  return;
}

// NEXT CLUE
if (cbData === "next_clue") {
  const clues = JSON.parse(User.get("char_clues") || "[]");
  let idx = (User.get("char_clue_idx") || 0) + 1;
  if (idx >= clues.length) {
    Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "دیگه سرنخی نمونده!" });
    return;
  }
  User.set("char_clue_idx", idx, "number");
  addScore(-1);
  Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "-1 امتیاز" });
  const btns = [];
  if (idx < clues.length - 1) btns.push([{ text: "🔍 سرنخ بعدی (-1 امتیاز)", callback_data: "next_clue" }]);
  btns.push([{ text: "🏳️ تسلیم شدم", callback_data: "give_up" }]);
  btns.push([{ text: "🏠 منو", callback_data: "main_menu" }]);
  Api.editMessageText({
    chat_id: cbChatId, message_id: cbMsgId,
    text: "🔑 سرنخ " + (idx + 1) + " از " + clues.length + ":\n" + clues[idx] + "\n\n✍️ حالا اسمش رو بنویس:",
    reply_markup: { inline_keyboard: btns }
  });
  return;
}

// GIVE UP
if (cbData === "give_up") {
  const charName = User.get("char_name") || "نامشخص";
  User.set("char_state", "done");
  addScore(-2);
  Api.answerCallbackQuery({ callback_query_id: cbQueryId });
  Api.editMessageText({
    chat_id: cbChatId, message_id: cbMsgId,
    text: "😅 جواب: " + charName + "\n\nدفعه بعد موفق میشی! (-2 امتیاز)",
    reply_markup: { inline_keyboard: [
      [{ text: "🔄 دوباره بازی", callback_data: "start_character" }],
      [{ text: "🏠 منو", callback_data: "main_menu" }]
    ]}
  });
  return;
}

// START AI CHAT
if (cbData === "start_chat") {
  Api.answerCallbackQuery({ callback_query_id: cbQueryId });
  User.set("chat_mode", "ai");
  Api.editMessageText({
    chat_id: cbChatId, message_id: cbMsgId,
    text: "🤖 حالا می‌تونی هر چیزی بپرسی!\n\nبرای خروج بنویس: /stop",
  });
  return;
}

// MY SCORE
if (cbData === "my_score") {
  Api.answerCallbackQuery({ callback_query_id: cbQueryId });
  const score = User.get("score") || 0;
  let rank = "🥉 تازه‌کار";
  if (score >= 50) rank = "🥇 افسانه";
  else if (score >= 20) rank = "🥈 حرفه‌ای";
  else if (score >= 10) rank = "⭐ کاربر فعال";
  Api.editMessageText({
    chat_id: cbChatId, message_id: cbMsgId,
    text: "⭐ امتیاز تو: " + score + "\n🏅 رتبه: " + rank + "\n\n💡 با حدس شخصیت امتیاز بیشتر بگیر!",
    reply_markup: { inline_keyboard: [[{ text: "🏠 منو", callback_data: "main_menu" }]] }
  });
  return;
}

// REACTIONS
if (cbData === "react_funny" || cbData === "react_meme" || cbData === "react_dialogue") {
  addScore(2);
  Api.answerCallbackQuery({ callback_query_id: cbQueryId, text: "❤️ +2 امتیاز!" });
  return;
}